{
    "parser": "@typescript-eslint/parser",
    "plugins": ["prettier", "import", "@typescript-eslint"],
    "ignorePatterns": ["*.config.js", "./src/components/controller/appLoader.js"],
    "extends": [
        "eslint:recommended",                          // Подключение базовых правил ESLint.
        "plugin:@typescript-eslint/recommended" 
    ],
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
    },
    "env": {
        "es6": true,
        "browser": true,
        "node": true
    },
    "rules": {
        "no-debugger": "off",
        "no-console": 0,
        "class-methods-use-this": "off",
        "@typescript-eslint/no-explicit-any": "warn"
    }
}
