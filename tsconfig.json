{
  "compilerOptions": {
    "target": "es6",                          // Указывает версию ECMAScript для выходных файлов (например, es5, es6, esnext).
    "module": "commonjs",                      // Указывает тип модулей (например, commonjs, esnext).
    "strict": true,
    "noImplicitAny": true,                            // Включает строгий режим проверки типов.
    "esModuleInterop": true,                   // Включает поддержку импорта CommonJS модулей в стиле ES6.
    "skipLibCheck": true,                      // Пропускает проверку типов в библиотеках (может ускорить компиляцию).
    "forceConsistentCasingInFileNames": true,  // Принудительное соблюдение регистра в именах файлов.
    "outDir": "./dist",                        // Указывает директорию для вывода скомпилированных файлов.
    "rootDir": "./src",
    "baseUrl": "./src",   
    "types": ["node"]                     // Указывает корневую директорию исходных файлов.
  },
  "include": ["src/**/*"],                     // Указывает, какие файлы будут включены в проект (например, все файлы в src).
  "exclude": ["node_modules"],                 // Указывает, какие файлы или каталоги должны быть исключены.
}